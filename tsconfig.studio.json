{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/studio/**/*",
    "src/studio-server/**/*",
    "tools/studio.mts",
    "vite.studio.config.ts"
  ]
}
